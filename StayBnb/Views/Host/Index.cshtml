@model List<StayBnb.Models.HostProperty>

@{
    ViewData["Title"] = "Host Dashboard";
}

<h1>Host Dashboard</h1>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="alert">
        @success
    </div>
}

<p>Welcome, @User.Identity?.Name.</p>

<p>
    <a asp-controller="Host" asp-action="BookingRequests" class="btn btn-primary">
        Booking Requests
    </a>
</p>

<h2 class="h4">My approved properties</h2>

@if (Model.Count == 0)
{
    <p>You have no approved properties.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Property</th>
                    <th>Address</th>
                    <th>Price per night</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var property in Model)
                {
                    <tr>
                        <td>@property.Title</td>
                        <td>@property.Address</td>
                        <td>R @property.PricePerNight.ToString("F2")</td>
                        <td>
                            @(property.IsActive ? "Active" : "Inactive")
                        </td>
                        <td>
                            <a asp-controller="Host" asp-action="Edit" asp-route-id="@property.Id" class="btn btn-sm btn-primary">
                                Edit
                            </a>

                            <form asp-controller="Host" asp-action="SetActive" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@property.Id" />

                                <input type="hidden" name="isActive" value="@(property.IsActive ? "false" : "true")" />

                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    @(property.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}