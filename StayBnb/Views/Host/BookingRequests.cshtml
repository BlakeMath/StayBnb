@model List<StayBnb.ViewModels.HostBookingListViewModel>

@{
    ViewData["Title"] = "Booking Requests";
}

<h1>Booking Requests</h1>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="alert">
        @success
    </div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

@if (Model.Count == 0)
{
    <p>There are no pending booking requests.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Booking</th>
                    <th>Property</th>
                    <th>Guest</th>
                    <th>Check-in</th>
                    <th>Check-out</th>
                    <th>Travelers</th>
                    <th>Total</th>
                    <th>Decision</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>@booking.BookingId</td>
                        <td>@booking.PropertyTitle</td>
                        <td>@booking.GuestEmail</td>
                        <td>
                            @booking.CheckInDate.ToString("dd MMM yyyy")
                        </td>
                        <td>
                            @booking.CheckOutDate.ToString("dd MMM yyyy")
                        </td>
                        <td>@booking.NumberOfTravelers</td>
                        <td>R @booking.TotalPrice.ToString("F2")</td>
                        <td>
                            <form asp-controller="Host" asp-action="ReviewBooking" method="post">
                                <input type="hidden" name="id" value="@booking.BookingId" />

                                <button type="submit" name="decision" value="Approve" class="btn btn-sm btn-success">
                                    Approve
                                </button>

                                <button type="submit" name="decision" value="Reject" class="btn btn-sm btn-danger">
                                    Reject
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-controller="Host" asp-action="Index">
    Back to dashboard
</a>