@model List<StayBnb.ViewModels.HostBookingListViewModel>
@using StayBnb.Models

@{
    ViewData["Title"] = "Confirmed Bookings";
}

<h1>Confirmed Bookings</h1>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="alert">
        @success
    </div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

@if (Model.Count == 0)
{
    <p>You have no confirmed bookings.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Booking</th>
                    <th>Property</th>
                    <th>Guest</th>
                    <th>Check-in</th>
                    <th>Check-out</th>
                    <th>Travelers</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>@booking.BookingId</td>
                        <td>@booking.PropertyTitle</td>
                        <td>@booking.GuestEmail</td>
                        <td>@booking.CheckInDate.ToString("dd MMM yyyy")</td>
                        <td>@booking.CheckOutDate.ToString("dd MMM yyyy")</td>
                        <td>@booking.NumberOfTravelers</td>
                        <td>R @booking.TotalPrice.ToString("F2")</td>
                        <td>@booking.Status</td>
                        <td>
                            @if (booking.Status == BookingStatus.Approved)
                            {
                                <form asp-controller="Host" asp-action="MarkArrived" method="post">
                                    <input type="hidden" name="bookingId" value="@booking.BookingId" />

                                    <button type="submit" class="btn btn-sm btn-success">
                                        Mark arrived
                                    </button>
                                </form>
                            }
                            else if (booking.Status == BookingStatus.CheckedIn)
                            {
                                <form asp-controller="Host" asp-action="MarkDeparted" method="post">

                                    <input type="hidden" name="bookingId" value="@booking.BookingId" />

                                    <button type="submit" class="btn btn-sm btn-primary">
                                        Mark departed
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-controller="Host" asp-action="BookingRequests" class="btn btn-primary">
    Pending requests
</a>

<a asp-controller="Host" asp-action="Index" class="btn btn-outline-secondary">
    Back to dashboard
</a>