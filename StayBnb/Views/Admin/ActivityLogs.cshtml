@model List<StayBnb.Models.ActivityLog>

@{
    ViewData["Title"] = "Activity Logs";
}

<h1>Activity Logs</h1>

@if (Model.Count == 0)
{
    <p>No activity has been recorded yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Date and time</th>
                    <th>User ID</th>
                    <th>Activity type</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>
                            @log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                        </td>
                        <td>@log.UserId</td>
                        <td>@log.ActivityType</td>
                        <td>@log.Action</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-controller="Admin" asp-action="Index">
    Back to dashboard
</a>