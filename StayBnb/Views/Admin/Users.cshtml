@model List<Microsoft.AspNetCore.Identity.IdentityUser>

@{
    ViewData["Title"] = "User Management";
}

<h1>User Management</h1>

<p>Find a Guest and promote their account to Admin.</p>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="alert">
        @success
    </div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

<form asp-controller="Admin" asp-action="Users"
      method="get" class="mb-3">

    <label for="search" class="form-label">Search by email</label>

    <div class="input-group">
        <input id="search"
               name="search"
               value="@ViewData["Search"]"
               class="form-control"
               placeholder="Enter an email address" />

        <button type="submit" class="btn btn-primary">
            Search
        </button>

        <a asp-controller="Admin"
           asp-action="Users"
           class="btn btn-outline-secondary">
            Clear
        </a>
    </div>
</form>

@if (Model.Count == 0)
{
    <p>No eligible Guests found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>
                        <form asp-controller="Admin"
                              asp-action="PromoteToAdmin"
                              method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@user.Id" />

                            <button type="submit"
                                    class="btn btn-primary">
                                Promote to Admin
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Admin" asp-action="Index">
    Back to dashboard
</a>