@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>

<p>Welcome, @User.Identity?.Name.</p>

<p>
    This is where you will review hosting applications
    and monitor activity logs.
</p>

@if (User.IsInRole("SuperAdmin"))
{
    <a asp-controller="Admin" asp-action="Users" class="btn btn-primary"> Manage Users </a>
}

<a asp-controller="Admin" asp-action="ActivityLogs" class="btn btn-secondary"> View Activity Logs </a>

<a asp-controller="Admin" asp-action="HostApplications" class="btn btn-primary"> Review Host Applications </a>